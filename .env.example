# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for creating branches and PRs)
APP_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Configuration (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_VERSION=2025-04-01-preview
AZURE_OPENAI_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Optional: Target GitHub repository for generated mappings
# Overrides the value in config.yaml (default: redlink-gmbh/ogd-to-lod-mappings)
# GITHUB_REPO=redlink-gmbh/ogd-to-lod-mappings

# Optional: Huwise domain (required for the `ogd-to-lod-huwise` command)
# Example: data.bs.ch
# The command derives: https://<HUWISE_DOMAIN>/api/explore/v2.1
# HUWISE_DOMAIN=data.bs.ch
# optional huwise_api_key required for reuploading rdf mapping to huwise
# HUWISE_API_KEY=your-automation-api-key-here

# Optional: Log level for debugging and tracing
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG - Detailed information for diagnosing problems
# INFO - General operational events (default)
# WARNING - Something unexpected happened
# ERROR - Serious problem occurred
LOG_LEVEL=INFO
